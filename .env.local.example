# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API

# Public keys (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (server-only — NEVER expose to the browser)
# Used by API routes that need to bypass RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Admin API key ─────────────────────────────────────────────────────────────
# A secret string you make up — the main website sends this header when calling
# your admin API routes (POST /api/listings, PUT /api/listings/:id, DELETE ...)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=your-secret-api-key-here

# ── MongoDB (listings storage) ─────────────────────────────────────────────────
# Atlas connection string. Get it from: Atlas → Database → Connect → Drivers
MONGODB_URI=mongodb+srv://Raeed%40123@cluster0.xxxxx.mongodb.net/stevenmoning?appName=Cluster0

# ── Upstash Redis (listings cache) ─────────────────────────────────────────────
# OPTIONAL cache-aside layer in front of the listings read path (lib/listings.ts),
# with version-based invalidation on writes + rolling pre-write snapshots.
# If these are absent the cache no-ops and reads fall straight through to Mongo.
# Get them from: https://console.upstash.com → your Redis DB → REST API section.
UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token-here