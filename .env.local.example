# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API

# Public keys (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (server-only — NEVER expose to the browser)
# Used by API routes that need to bypass RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Admin API key ─────────────────────────────────────────────────────────────
# A secret string you make up — the main website sends this header when calling
# your admin API routes (POST /api/listings, PUT /api/listings/:id, DELETE ...)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=your-secret-api-key-here

# ── MongoDB (listings storage) ─────────────────────────────────────────────────
# Atlas connection string. Get it from: Atlas → Database → Connect → Drivers
# Keep this a placeholder. This file is committed, so anything real written here
# is published — percent-encode any special characters in the password (@ is %40).
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/stevenmoning?appName=Cluster0

# ── BoldTrail / kvCORE sync ───────────────────────────────────────────────────
# OPTIONAL. Without a token the sync page reports "not connected" and the CSV
# importer remains the way contacts come across.
#
# Generate a token in BoldTrail: Lead Engine → Lead Dropbox → My API Tokens →
# tick the scope (Contacts, or All) → Generate. Max 3 active tokens per account
# and each one EXPIRES AFTER A YEAR — an expired token shows up as a hard 401.
#
# Before trusting any of this, run the probe to see what the account exposes:
#   node --env-file=.env.local scripts/probe-boldtrail.mjs
BOLDTRAIL_API_TOKEN=your-boldtrail-api-token-here
# A fixed hostname — there is nothing to look up in the BoldTrail UI for this.
# Do NOT put the lead-dropbox email address here: the "notes+…@kvcore.com"
# address on that same screen is for forwarding lead emails into BoldTrail and
# is not an API endpoint.
BOLDTRAIL_API_BASE=https://api.kvcore.com
# Floor on the gap between API calls, in ms. Requests are issued serially, never
# in parallel.
#
# 2000 is deliberately slow. The only measurement we have is that roughly 150
# requests inside five minutes locked the account out — every endpoint returning
# 401 "Authentication Failed" with a token that had worked moments earlier, and
# not recovering within three minutes. The real threshold is unknown, and the
# only way to find it is to trigger it again on live client data. So this sits
# far below any plausible limit instead.
BOLDTRAIL_MIN_INTERVAL_MS=2000

# Contacts whose full 83-field record is fetched per run. That endpoint costs
# one request PER CONTACT, so it is rationed: the cheap list endpoint already
# gives name, email, phone and source for everyone in two requests, and the rest
# fills in over the following weeks. Raise it only once the run history shows
# the API is comfortable.
BOLDTRAIL_DETAIL_BATCH=25

# Kill switch — set to "false" to make every sync run a no-op without pulling
# the token out of the environment.
BOLDTRAIL_SYNC_ENABLED=true

# ── Cron ──────────────────────────────────────────────────────────────────────
# Vercel Cron sends this automatically as `Authorization: Bearer <secret>` when
# it is set as a project environment variable. The sync route also accepts the
# ordinary ADMIN_API_KEY header, so you can trigger a run by hand with curl.
CRON_SECRET=another-secret-string-here

# ── Upstash Redis (listings cache) ─────────────────────────────────────────────
# OPTIONAL cache-aside layer in front of the listings read path (lib/listings.ts),
# with version-based invalidation on writes + rolling pre-write snapshots.
# If these are absent the cache no-ops and reads fall straight through to Mongo.
# Get them from: https://console.upstash.com → your Redis DB → REST API section.
UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token-here